# Copy to backend/.env and fill in. Never commit the real .env.
# Read by django-environ in config/settings.py (wired up in step 2).

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Create the database first:
#   createdb invoice_mgmt
#
# Homebrew's postgres creates a superuser role named after your macOS user and uses
# trust auth on localhost, so no password is needed. There is no "postgres" role.
# Substitute your own username; on other setups use the full form:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://darshil@localhost:5432/invoice_mgmt

# Vite dev server origin — required, the frontend is cross-origin (see architecture.md section 1).
CORS_ALLOWED_ORIGINS=http://localhost:5173
